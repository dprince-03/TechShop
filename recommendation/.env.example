# Copy to .env and fill in. NEVER add DATABASE_URL (that is Go's main database).
# The recommender's own private database (recs-postgres service, Docker network only):
RECS_DATABASE_URL=postgres://recs:REPLACE_WITH_LONG_RANDOM_PASSWORD@recs-postgres:5432/recs?sslmode=disable
TECHSHOP_INTERNAL_URL=http://api:8081/internal
RECS_CLIENT_ID=recommender
RECS_CLIENT_SECRET=change-me-to-a-long-random-secret
ARTIFACT_DIR=./artifacts
