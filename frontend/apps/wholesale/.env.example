# Copy to .env.local. This app never connects to the database; all data goes through the Go API.

# Go API base URL. Only server code calls it (BFF): the browser never talks to the API.
API_URL=http://localhost:8080


# Encrypts this app's session cookie (AES-GCM). At least 32 random characters, e.g.
#   openssl rand -base64 32
# Required for production builds; local `next dev` falls back to a development-only key.
SESSION_SECRET=
