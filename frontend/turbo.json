{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "../../../shared/**"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$", "../../../shared/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
