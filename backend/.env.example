# Copy to .env and fill in values. Every setting the API reads is listed here.
#
# Secrets: leave them empty in development — the API generates random per-process values.
# Outside development (test excepted) the API refuses to start if a secret is missing, shorter
# than 32 characters, or looks like a placeholder; it also refuses fake payments, log-only
# messaging, a local KEK and a weak database password.

# ---- App
APP_ENV=development                 # development | test | staging | production
PORT=8080                           # public API
INTERNAL_ADDR=:8081                 # internal listener (health, metrics, service APIs); never routed by nginx
APP_BASE_URL=http://localhost:8080  # used in links the API generates (fake checkout, tracked links, unsubscribe)
LOG_LEVEL=info                      # debug | info | warn | error
TRUSTED_PROXIES=127.0.0.1           # comma-separated; client IPs are taken from X-Forwarded-For only behind these
WORKER_IN_PROCESS=true              # run River jobs and the outbox relay inside the API (local); production runs cmd/worker
WORKER_CONCURRENCY=10

# ---- Database
DATABASE_URL=postgres://techshop:techshop@localhost:5432/techshop?sslmode=disable
# Apply pending migrations when the API starts (handy locally; in CI/CD prefer `make migrate-up`)
DB_MIGRATE_ON_STARTUP=false
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_STATEMENT_TIMEOUT=15s

# ---- HTTP
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://techshop.localhost,http://market.techshop.localhost,http://wholesale.techshop.localhost,http://seller.techshop.localhost,http://staff.techshop.localhost
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_SHUTDOWN_TIMEOUT=10s

# ---- Auth (docs/identity-access.md §5)
# "kid:base64(32-byte Ed25519 seed),kid2:…" — the first key signs; the others still verify (rotation).
JWT_SIGNING_KEYS=
JWT_ISSUER=https://api.techshop.ng
ACCESS_TOKEN_TTL=10m
STAFF_ACCESS_TOKEN_TTL=5m
STEP_UP_MAX_AGE=10m                 # sensitive actions need an MFA check this recent
OTP_HMAC_KEY=                       # hashes OTP codes
OTP_TTL=10m
CURSOR_HMAC_KEY=                    # signs pagination cursors
TOKEN_HMAC_KEY=                     # signs signup/MFA tokens, unsubscribe and click-redirect links

# ---- Crypto (envelope encryption; docs/backend.md §5.3)
KMS_PROVIDER=local                  # local is development-only
LOCAL_KEK=                          # base64 32 bytes; development only
BLIND_INDEX_KEY=                    # searchable HMAC of encrypted fields (BVN, account numbers)

# ---- Payments (docs/payments-finance.md). PLACEHOLDER values await owner/finance decisions.
PAYMENTS_FAKE=true                  # fake providers + /dev/pay pages; must be false outside development
PAYMENTS_ENABLED_PROVIDERS=paystack,opay,moniepoint   # outside development only paystack has a live adapter
PAYSTACK_SECRET_KEY=
MONNIFY_API_KEY=                    # Moniepoint (Monnify) — live adapter not built yet
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
OPAY_MERCHANT_ID=                   # OPay — live adapter not built yet
OPAY_SECRET_KEY=
PAYMENT_CALLBACK_URL=http://localhost:3001/checkout/return
ORDER_PAYMENT_TTL=30m               # card/wallet/USSD payment window; stock is held this long
TRANSFER_ACCOUNT_TTL=30m            # validity of a one-time transfer account
RETURN_WINDOW_DAYS=7                # PLACEHOLDER (owner decision: return policy)
VAT_BPS=750                         # PLACEHOLDER 7.5% until finance confirms the VAT treatment
DEFAULT_COMMISSION_BPS=1000         # PLACEHOLDER 10% marketplace commission (owner decision)
REFUND_MANAGER_THRESHOLD_KOBO=50000000      # refunds above ₦500,000 need refunds.approve (finance manager)
PAYOUT_APPROVAL_THRESHOLD_KOBO=5000000000   # payout batches above ₦50m need a second approver
PAYOUT_MINIMUM_KOBO=500000                  # ₦5,000 minimum payout
LATE_PAYMENT_POLICY=reinstate_or_refund     # PLACEHOLDER (owner decision #57): reinstate_or_refund | refund
DELIVERY_FEE_TECHSHOP_KOBO=250000           # same-state delivery of TechShop stock (until zone rates exist)
DELIVERY_FEE_VENDOR_KOBO=350000             # same-state seller-shipped delivery
DELIVERY_FEE_INTERSTATE_KOBO=650000         # any delivery across a state line

# ---- Messaging (docs/messaging-marketing.md)
SMS_PROVIDER=log                    # log (development) | termii
TERMII_API_KEY=
TERMII_SENDER_ID=TechShop
EMAIL_PROVIDER=log                  # log (development) | ses
EMAIL_FROM=TechShop <hello@mail.techshop.ng>
PUSH_PROVIDER=log                   # log (development) | expo
EXPO_ACCESS_TOKEN=
QUIET_HOURS_START=21:00             # Lagos time; marketing waits until the end of quiet hours
QUIET_HOURS_END=08:00

# ---- File storage
STORAGE_PROVIDER=fake               # fake (development, served by /dev/files) | s3 (MinIO or AWS)
S3_ENDPOINT=                        # e.g. http://minio:9000
S3_REGION=us-east-1
S3_BUCKET_PUBLIC=techshop-public
S3_BUCKET_PRIVATE=techshop-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
PUBLIC_ASSET_BASE_URL=http://localhost:9000/techshop-public

# ---- Integrations (fake by default; no live calls)
KYC_PROVIDER=manual
CARRIER_PROVIDER=fake
RECS_LIVE_URL=                      # optional live recommender; empty = Go rules only
RECS_LIVE_TIMEOUT=80ms
