# Copy to .env and fill in values.

APP_ENV=development
PORT=8080

DATABASE_URL=postgres://techshop:techshop@localhost:5432/techshop?sslmode=disable

# Apply pending migrations when the API starts (handy locally; in CI/CD prefer `make migrate-up`)
DB_MIGRATE_ON_STARTUP=false

# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005,http://techshop.localhost,http://market.techshop.localhost,http://wholesale.techshop.localhost,http://seller.techshop.localhost,http://staff.techshop.localhost

HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_SHUTDOWN_TIMEOUT=10s
